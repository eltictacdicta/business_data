{# Sedes de la empresa. Un formulario por sede, cada uno con su propio campo
   CSRF, más un formulario de alta siempre visible (nunca un modal: este panel
   se oculta con .hide(), así que un .modal anidado no llegaría a renderizar).
   Ambos marcadores (`save_sede` / `delete_sede`) se evalúan antes que `nombre`
   en admin_empresa::resolveAction(), para que guardar una sede nunca
   sobrescriba la fila de la empresa base. #}
{% if fsc.sedes is empty %}
<div class="panel panel-info">
    <div class="panel-body">
        <p class="help-block">
            No hay sedes configuradas. Todos los documentos usan los datos de la empresa base.
        </p>
    </div>
</div>
{% endif %}

{% for sede in fsc.sedes %}
<form action="{{ fsc.url() }}#sedes" method="post" class="form">
    {{ csrf_field() }}
    <input type="hidden" name="codsede" value="{{ sede.codsede }}"/>
    <div class="panel panel-primary">
        <div class="panel-heading">
            <h3 class="panel-title">
                {{ sede.descripcion ?: sede.nombre }} <small>({{ sede.codsede }})</small>
            </h3>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        Descripción:
                        <input class="form-control" type="text" name="descripcion" maxlength="100"
                            value="{{ sede.descripcion }}" placeholder="Sede principal" autocomplete="off"/>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="form-group">
                        Nombre:
                        <input class="form-control" type="text" name="nombre" maxlength="100"
                            value="{{ sede.nombre }}" autocomplete="off" required=""/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        CIF/NIF:
                        <input class="form-control" type="text" name="cifnif" maxlength="30"
                            value="{{ sede.cifnif }}" autocomplete="off"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        Teléfono:
                        <input class="form-control" type="text" name="telefono" maxlength="20"
                            value="{{ sede.telefono }}" autocomplete="off"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        Email:
                        <input class="form-control" type="email" name="email" maxlength="100"
                            value="{{ sede.email }}" autocomplete="off"/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6">
                    <div class="form-group">
                        Dirección:
                        <input class="form-control" type="text" name="direccion" maxlength="100"
                            value="{{ sede.direccion }}" autocomplete="off"/>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        Apartado:
                        <input class="form-control" type="text" name="apartado" maxlength="10"
                            value="{{ sede.apartado }}" autocomplete="off"/>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-group">
                        Código postal:
                        <input class="form-control" type="text" name="codpostal" maxlength="10"
                            value="{{ sede.codpostal }}" autocomplete="off"/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-4">
                    <div class="form-group">
                        Ciudad:
                        <input class="form-control" type="text" name="ciudad" maxlength="100"
                            value="{{ sede.ciudad }}" autocomplete="off"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        Provincia:
                        <input class="form-control" type="text" name="provincia" maxlength="100"
                            value="{{ sede.provincia }}" autocomplete="off"/>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="form-group">
                        País:
                        <input class="form-control" type="text" name="codpais" maxlength="20"
                            value="{{ sede.codpais }}" placeholder="ESP" autocomplete="off"/>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-12">
                    <div class="form-group">
                        Web:
                        <input class="form-control" type="text" name="web" maxlength="100"
                            value="{{ sede.web }}" autocomplete="off"/>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel-footer text-right">
            <div class="btn-group">
                <button class="btn btn-sm btn-primary" type="submit" name="save_sede" value="1">
                    <span class="glyphicon glyphicon-floppy-disk"></span>&nbsp; Guardar
                </button>
                <button class="btn btn-sm btn-danger" type="submit" name="delete_sede" value="{{ sede.codsede }}">
                    <span class="glyphicon glyphicon-trash"></span>&nbsp; Eliminar
                </button>
            </div>
        </div>
    </div>
</form>
{% endfor %}

